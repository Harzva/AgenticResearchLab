[Unit]
Description=Generate AgentHot daily research edition
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=agenthot-daily
Group=agenthot-daily
ExecStart=/usr/bin/python3 /srv/harzva-agent-hot/bin/current/daily.py --feed /srv/harzva-agent-hot/current/agent-hot/feed.json --out /srv/harzva-agent-hot/live/agent-hot/daily
Environment=PYTHONDONTWRITEBYTECODE=1
TimeoutStartSec=80s
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/srv/harzva-agent-hot/live/agent-hot/daily
