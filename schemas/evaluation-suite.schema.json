{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Harzva/AgenticResearchLab/schemas/evaluation-suite.schema.json",
  "title": "AgenticResearchLab Evaluation Suite",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "tier",
    "review_status",
    "corpus",
    "evaluations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "tier": {"enum": ["required", "scheduled", "manual"]},
    "review_status": {"enum": ["automated", "draft", "reviewed"]},
    "corpus": {
      "type": "object",
      "required": ["id", "catalog_version", "schema_version", "source_sha256", "papers"],
      "properties": {
        "id": {"type": "string"},
        "catalog_version": {"type": "string"},
        "schema_version": {"type": "string"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "papers": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "evaluations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "task", "thresholds"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "task": {
            "enum": [
              "code-links",
              "retrieval-smoke",
              "proposal-regression",
              "fulltext-quality",
              "semantic-retrieval",
              "citation-quality"
            ]
          },
          "dataset": {"type": "string"},
          "configuration": {"type": "object"},
          "thresholds": {
            "type": "object",
            "additionalProperties": {"type": "number"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
