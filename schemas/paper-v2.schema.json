{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Harzva/AgenticResearchLab/schemas/paper-v2.schema.json",
  "title": "AgenticResearchLab Paper v2",
  "type": "object",
  "required": [
    "id", "canonical_id", "conference", "year", "paper_id", "title", "authors",
    "selection", "links", "topics", "tasks", "environments", "modalities",
    "agentic_components", "methods", "benchmarks", "datasets", "metrics", "claims",
    "limitations", "failure_modes", "artifacts", "evidence", "enrichment_status"
  ],
  "properties": {
    "id": {"type": "string"},
    "canonical_id": {"type": "string"},
    "conference": {"type": "string"},
    "year": {"type": "integer", "minimum": 2000},
    "paper_id": {"type": "string"},
    "doi": {"type": ["string", "null"]},
    "version": {"type": ["string", "null"]},
    "updated_at": {"type": ["string", "null"]},
    "title": {"type": "string"},
    "authors": {"type": "array", "items": {"type": "string"}},
    "abstract": {"type": ["string", "null"]},
    "track": {"type": ["string", "null"]},
    "selection": {"type": "object"},
    "links": {"type": "object"},
    "topics": {"type": "array", "items": {"type": "string"}},
    "tasks": {"type": "array", "items": {"type": "string"}},
    "environments": {"type": "array", "items": {"type": "string"}},
    "modalities": {"type": "array", "items": {"type": "string"}},
    "agentic_components": {"type": "array", "items": {"type": "string"}},
    "methods": {"type": "array", "items": {"type": "string"}},
    "benchmarks": {"type": "array", "items": {"type": "string"}},
    "datasets": {"type": "array", "items": {"type": "string"}},
    "metrics": {"type": "array", "items": {"type": "string"}},
    "claims": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "failure_modes": {"type": "array", "items": {"type": "string"}},
    "artifacts": {"type": "object"},
    "evidence": {"type": "array", "items": {"$ref": "evidence.schema.json"}},
    "enrichment_status": {"type": "object"}
  },
  "additionalProperties": false
}
