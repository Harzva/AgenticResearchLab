{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Harzva/AgenticResearchLab/schemas/evaluation-report.schema.json",
  "title": "AgenticResearchLab Evaluation Report",
  "type": "object",
  "required": [
    "report_schema_version",
    "id",
    "evaluation_suite",
    "corpus",
    "configuration",
    "evaluations",
    "summary",
    "passed"
  ],
  "properties": {
    "report_schema_version": {"const": "1.0"},
    "id": {"type": "string"},
    "evaluation_suite": {"type": "object"},
    "corpus": {"type": "object"},
    "configuration": {"type": "object"},
    "evaluations": {"type": "object"},
    "summary": {"type": "object"},
    "baseline_comparison": {"type": "object"},
    "validation": {"type": "object"},
    "passed": {"type": "boolean"}
  },
  "additionalProperties": false
}
